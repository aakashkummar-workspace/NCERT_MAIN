# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL connects as sahayak_app: a plain LOGIN role with NO superuser and
# NO BYPASSRLS. This matters more than it looks — a superuser bypasses row-level
# security unconditionally, which would make every tenancy policy inert and the
# cross-tenant test pass while proving nothing.
DATABASE_URL="postgresql://sahayak_app:sahayak_dev_password@localhost:5434/sahayak?schema=public"

# DIRECT_URL is the superuser, used ONLY by prisma migrate and by db:rls.
# In production it is also the non-pooled connection: migrations need session
# state (advisory locks, CREATE TYPE) that a transaction pooler does not give.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/sahayak?schema=public"

# The password db:rls assigns to sahayak_app. Must match DATABASE_URL.
APP_DB_PASSWORD="sahayak_dev_password"

# Curriculum authoring runs as its own role, with its own connection. A
# teacher-facing route physically cannot write curriculum because the connection
# it holds has no grant to do so — the role check in code is the second line of
# defence, not the only one.
PLATFORM_DATABASE_URL="postgresql://sahayak_platform:sahayak_platform_password@localhost:5434/sahayak?schema=public"
PLATFORM_DB_PASSWORD="sahayak_platform_password"

# Supabase. The production database is Supabase (docs/SUPABASE.md): all four
# URLs above point at its SESSION pooler (port 5432) with `?sslmode=require`,
# and the two app roles are written `sahayak_app.<project-ref>` /
# `sahayak_platform.<project-ref>`. Local Docker remains for the test suites,
# which refuse any remote database (scripts/lib/local-database.mjs).
#
# Only for the one-time move (scripts/migrate-to-supabase.mjs): the LOCAL
# superuser connection the data is copied from.
SOURCE_DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# There is deliberately no session secret.
#
# A session token here is 32 random bytes, stored as a SHA-256 hash and looked
# up by that hash — it is opaque and carries no claims, so there is nothing to
# sign and no key that could be rotated. Revoking a session is deleting a row,
# which is stronger than any signing scheme: a signed token stays valid until it
# expires, whatever the server thinks of it.
#
# This file used to declare SESSION_SECRET and SESSION_SECRET_PREVIOUS, and the
# README told you to generate one. Nothing has ever read either. An operator who
# rotated it, believing it would sign everyone out, would have changed nothing
# at all — which is a worse failure than the variable simply not existing.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3210"
NODE_ENV="development"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# The bearer token /api/cron/sweep-attempts requires. Unset, that route refuses
# everything — a deploy that forgets this fails loudly rather than leaving an
# unauthenticated endpoint that writes to every tenant.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# The shared question library (src/core/library). The slug of the organization
# whose approved questions every CBSE school receives; unset, new schools start
# with an empty bank. Schedule POST /api/cron/share-library/ every few minutes.
QUESTION_LIBRARY_SOURCE=""
# "true" ONLY once NCERT has granted permission in writing: it copies the
# verbatim NCERT Exemplar questions too. Sahayak is commercial.
QUESTION_LIBRARY_INCLUDE_EXEMPLAR=""

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Unset, the gateway falls back to a mock provider: the product runs, every
# guard is exercised, and nothing costs anything. A missing key is a visibly
# mocked answer rather than a crash on a page a teacher opened.
ANTHROPIC_API_KEY=""

# Local testing only: "claude-code" answers through your own Claude Code login
# (the Claude Agent SDK, a devDependency) instead of an API key. Anthropic does
# not allow a subscription login to power a product other people use, so the
# app refuses to start with it unless DATABASE_URL is on this machine.
AI_PROVIDER=""

# Tiers map to models HERE, never in business logic. Moving BALANCED to a
# different model is this line, not a deploy.
AI_MODEL_FAST=""
AI_MODEL_BALANCED=""
AI_MODEL_DEEP=""

# Ceilings per organization, in millionths of a dollar. Checked before the
# call, not reconciled after — a budget discovered once the money is gone is a
# report, not a control. Defaults: $3 a day, $20 a month.
AI_BUDGET_DAY_MICROS=""
AI_BUDGET_MONTH_MICROS=""

# ---------------------------------------------------------------------------
# Database transactions
# ---------------------------------------------------------------------------
# How long a tenant transaction may run, and how long it may wait for a
# connection from the pool. Prisma's defaults are 5s and 2s; both were
# unchosen and both are too tight under load - a class of thirty submitting at
# once is a pool burst, and submitting runs inside a tenant transaction.
# Raise only with a reason: a transaction held this long holds its row locks
# for that long too, and everybody else waits.
DB_TRANSACTION_TIMEOUT_MS="15000"
DB_TRANSACTION_MAX_WAIT_MS="10000"

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------
# A student signs in with a phone number and a six-digit code. Without a
# provider here that code is issued and delivered nowhere, which is the one
# thing standing between this product and a real classroom.
#
#   none   the default. Codes are issued and never sent. The sign-in screen
#          says so rather than telling a student to check their phone.
#   log    development. The code is printed to the server terminal — prefer
#          this over reading it out of the API response, which puts a
#          credential in a browser's network tab.
#   msg91  a real gateway.
SMS_PROVIDER="none"

# WhatsApp weekly digest for parents who opt in. "none" (default), "log"
# (prints to the terminal) or "meta" (WhatsApp Cloud API, needs the two below
# and the "weekly_progress_digest" template approved — see src/whatsapp).
WHATSAPP_PROVIDER="none"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

SMS_API_KEY=""
# The registered header, six letters, e.g. SAHYAK. Not a display name — the
# operator matches it.
SMS_SENDER_ID=""

# India requires every commercial SMS to match a template registered with a DLT
# registry, under a registered header. The operator drops anything else at the
# network, silently. So changing the wording in src/sms/templates.ts means
# re-registering and updating the id here — until both have happened, the old
# text is the only one that will arrive.
SMS_TEMPLATE_LOGIN_CODE=""
SMS_TEMPLATE_PARENT_INVITE=""

# The variable names the DLT template was registered under, comma-separated and
# in the order src/sms/templates.ts declares them. MSG91's default naming is
# VAR1, VAR2, ... and that is what the adapter sends when these are blank — but
# the real names live in a registration somebody filed, they are CASE-SENSITIVE,
# and a name that does not match leaves the slot empty in the delivered message
# rather than failing. Set these if the paperwork used anything else.
SMS_TEMPLATE_LOGIN_CODE_VARS=""
SMS_TEMPLATE_PARENT_INVITE_VARS=""

# MSG91's v5 flow endpoint. Overridable only so a staging account or a recorded
# proxy can be pointed at; there is no reason to change it in production.
SMS_MSG91_ENDPOINT="https://api.msg91.com/api/v5/flow/"
# How long to wait for the provider. A student is holding a phone in front of a
# sign-in form while this runs, so it is short on purpose: much longer and they
# press the button again, which issues a second code and invalidates the first.
SMS_MSG91_TIMEOUT_MS="8000"

# What the whole product may send in a day. This protects the BILL, not a
# person: the per-number hourly limit in prisma/rls.sql is what protects
# somebody's phone. An attacker cycling through ten thousand numbers passes
# that one every time and spends real money doing it.
SMS_DAILY_CEILING="2000"
